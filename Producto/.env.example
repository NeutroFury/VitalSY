# =============================================
# VitalSY - Docker Environment Configuration
# =============================================
# Copia este archivo y renómbralo a .env
# Completa los valores con tus propias credenciales.
# =============================================

# ── PostgreSQL (Local - mantenido para referencia) ──
POSTGRES_DB=vitalsy_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_local
DB_PORT=5432

# ── Supabase Override (sobreescribe el datasource del backend) ──
# Pide estas credenciales al administrador de la base de datos o crea una propia en Supabase
# TimeZone=UTC: Fija la zona de la sesión PostgreSQL — CRÍTICO para timestamps
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:5432/postgres?TimeZone=UTC&ApplicationName=vitalsy-backend&sslmode=require
SPRING_DATASOURCE_USERNAME=tu_usuario_supabase
SPRING_DATASOURCE_PASSWORD=tu_password_supabase

# ── Backend (Spring Boot) ──
BACKEND_PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# JWT Authentication
JWT_SECRET=CHANGE-ME-to-a-secure-random-string-in-production
JWT_EXPIRATION=3600000

# ── AI Configuration ──
# Google Gemini API Key (Crea una en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=tu_api_key_gemini_aqui

# Local AI (LM Studio / Ollama)
SPRING_AI_OPENAI_BASE_URL=http://host.docker.internal:1234
SPRING_AI_OPENAI_API_KEY=vitalsy-local

# ── Frontend (Nginx) ──
FRONTEND_PORT=80

# ── Mail Configuration (Mailtrap - Simulación SMTP) ──
# Obtén estas credenciales en https://mailtrap.io -> Email Testing -> tu inbox -> SMTP Settings
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=tu_usuario_mailtrap
MAIL_PASSWORD=tu_password_mailtrap

# URL del frontend Ionic (para links de recuperación de contraseña)
FRONTEND_URL=http://localhost
