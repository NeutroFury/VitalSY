# =============================================
# VitalSY - Docker Environment Configuration
# =============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control.
# =============================================

# ── PostgreSQL ──
POSTGRES_DB=vitalsy_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432

# ── Backend (Spring Boot) ──
BACKEND_PORT=8080

# JWT Authentication
JWT_SECRET=CHANGE-ME-to-a-secure-random-string-in-production
JWT_EXPIRATION=3600000

# ── AI Configuration ──
# Google Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=

# Local AI (LM Studio / Ollama)
SPRING_AI_OPENAI_BASE_URL=http://127.0.0.1:1234
SPRING_AI_OPENAI_API_KEY=vitalsy-local

# ── Frontend (Nginx) ──
FRONTEND_PORT=80
